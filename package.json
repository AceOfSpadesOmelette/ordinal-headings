{
	"name": "ordinal-headings",
	"version": "1.0.1",
	"description": "Ordinal Headings: live Word-style automatic numbering for Obsidian headings.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
