		"plugin",
		"headings",
		"numbering"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"builtin-modules": "3.3.0",
		"esbuild": "0.25.5",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "^5.8.3"
	}
}
